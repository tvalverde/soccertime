<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        A television has no touchscreen and no telephony, and declaring them not required is
        what makes the package installable on one at all. `android.software.leanback` is the
        feature the launcher looks for; it is not required either, so the same APK still runs
        on a phone if somebody sideloads it there.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Soccertime.Tv">

        <activity
            android:name=".TvActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true">
            <!--
                LEANBACK_LAUNCHER, not LAUNCHER: the Fire TV home screen only lists the first,
                and an activity carrying only the second is installed and unreachable.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
